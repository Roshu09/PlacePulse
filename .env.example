POSTGRES_USER=placepulse
POSTGRES_PASSWORD=change_me
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
KAFKA_BROKERS=localhost:9092
REDIS_HOST=localhost
# Anyone registering with this code becomes a TPR. Leave empty to disable TPR sign-up.
TPR_INVITE_CODE=
# Free key from https://console.groq.com/keys . Easiest way to set it: ./scripts/set-groq-key.sh
# Without it the resume matcher still works, using text similarity only (no written feedback).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
